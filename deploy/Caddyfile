# TLS do Cloudflare ket thuc o edge; Caddy chi phuc vu HTTP trong container.
:80 {
    encode zstd gzip

    # file build co hash trong ten -> cache dai han; index.html luon kiem tra lai
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"

    root * /srv
    try_files {path} /index.html
    file_server
}
